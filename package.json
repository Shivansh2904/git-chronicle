{
  "name": "git-chronicle",
  "version": "1.0.0",
  "description": "Rich git repository analytics in your terminal — heatmaps, author stats, language breakdown, file churn",
  "type": "module",
  "bin": { "git-chronicle": "./dist/index.js" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "ora": "^8.0.1",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^10.4.0",
    "tsx": "^4.8.2",
    "typescript": "^5.4.4",
    "vitest": "^1.5.0"
  },
  "engines": { "node": ">=18" }
}
