{
  "name": "git-chronicle",
  "version": "1.0.0",
  "description": "Rich git repository analytics in your terminal — heatmaps, author stats, language breakdown, file churn",
  "type": "module",
  "bin": { "git-chronicle": "./dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.3",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "simple-git": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": { "node": ">=18" }
}
